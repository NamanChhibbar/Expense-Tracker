# systemd unit for running the app on a Linux server.
# Assumes the repo is cloned to /opt/expense-tracker and a venv exists at .venv.
[Unit]
Description=Expense Tracker
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/expense-tracker
ExecStart=/opt/expense-tracker/.venv/bin/uvicorn backend.app:app --host 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always

[Install]
WantedBy=multi-user.target
